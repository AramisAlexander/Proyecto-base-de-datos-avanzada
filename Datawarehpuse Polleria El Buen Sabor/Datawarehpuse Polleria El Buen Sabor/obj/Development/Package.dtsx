                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
                         CAST(CONVERT(char(8), fecha_compra, 112) AS int) AS id_tiempo, fecha_compra AS fecha, DAY(fecha_compra) AS dia, MONTH(fecha_compra) AS mes, DATEPART(QUARTER, fecha_compra) AS trimestre, YEAR(fecha_compra) 
                         AS anio
FROM            Compras</property>
